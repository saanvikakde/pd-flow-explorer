# --- Secrets: never commit ---
.env
.env.*
!.env.example

# --- Local feedback log (personal data, stays on this machine) ---
feedback/log.jsonl
feedback/log.jsonl.bak
# feedback/index.jsonl (ids, timestamps, skills, reasons only) IS committed: CI checks skill citations against it.

# --- Python caches (scripts/check_skills.py) ---
__pycache__/

# --- Skill writer drafts and backups (apply a draft to make it SKILL.md) ---
skills/**/SKILL.draft.md
skills/**/SKILL.prev.md

# --- Dependencies ---
node_modules/

# --- Build output ---
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo
.vercel/
coverage/

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS files ---
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db

