# Copy this file to .env and fill in your token:
#   cp .env.example .env
#
# ASU CreateAI API token. Read only on the server; never sent to the browser.
# Leave empty to run in mock mode (answers show the assembled query instead).
CREATEAI_TOKEN=

# Optional: override the CreateAI endpoint.
# CREATEAI_URL=https://api-main.aiml.asu.edu/query
